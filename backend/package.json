{
  "name": "trex-registry-indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "ponder dev",
    "start": "ponder start --port ${PORT:-42069}",
    "codegen": "ponder codegen",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contracts": "vitest run --config vitest.contracts.config.ts",
    "compile:contracts": "hardhat compile",
    "deploy:sepolia": "tsx scripts/deploy.ts"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^4.8.3",
    "@openzeppelin/contracts-upgradeable": "^4.8.3",
    "ethers": "^6.13.0",
    "hono": "^4.6.0",
    "ponder": "^0.17.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.0",
    "hardhat": "^2.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.1"
  }
}
